---

<BaseLayout frontmatter={{ title: 'Преподаватели', description: 'Преподаватели Воскресной компьютерной школы.' }}>
  <h1>Преподаватели</h1>

  <figure class="teachers-group-photo">
    <img src="/images/teachers/prep2025.jpg" alt="Преподаватели Воскресной компьютерной школы, июнь 2025 года" width="1500" height="890" />
    <figcaption>Фото июнь 2025 г.</figcaption>
  </figure>

  <div class="teachers-list">
    {current.map((teacher) => (
      <article class="teacher">
        <img src={`/images/teachers/${teacher.photo}`} alt={teacher.name} width="108" height={teacher.height} loading="lazy" />
        <p><strong>{teacher.name}</strong> — {teacher.description}</p>
      </article>
    ))}
  </div>

  <h2>Преподаватели, работавшие в Компьютерной школе в прошлые годы</h2>
  <div class="teachers-list">
    {former.map((teacher) => (
      <article class="teacher">
        <img src={`/images/teachers/${teacher.photo}`} alt={teacher.name} width="108" height={teacher.height} loading="lazy" />
        <p><strong>{teacher.name}</strong> — {teacher.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .teachers-group-photo {
    width: min(100%, 750px);
    margin: 0 auto 12px;
    text-align: center;
  }

  .teachers-group-photo img { display: block; width: 100%; height: auto; }
  .teachers-group-photo figcaption { margin-top: 2px; }

  .teachers-list { display: grid; gap: 10px; }
  .teacher { display: flex; align-items: flex-start; gap: 14px; }
  .teacher img { flex: 0 0 108px; width: 108px; border-radius: 6px; }
  .teacher p { margin: 2px 0 0; }

  @media (max-width: 600px) {
    .teachers-group-photo { margin-bottom: 14px; }
    .teacher { gap: 10px; }
    .teacher img { flex-basis: 78px; width: 78px; height: auto; }
    .teacher p { margin-top: 0; }
  }
</style>
